<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavAdmin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_back_arrow"
                    android:tint="@color/black" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="THÊM SÁCH MỚI"
                    android:textColor="#000"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutSelectImage"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_upload_dashed"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/imgPreview"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_add"
                    android:tint="@color/black"/>
                <TextView
                    android:id="@+id/tvSelectImageLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Chọn ảnh bìa"
                    android:textColor="#0000FF"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                style="@style/LabelStyle"
                android:text="Tên sách"
                android:layout_marginTop="20dp"/>
            <EditText
                android:id="@+id/etBookName"
                style="@style/InputStyle"
                android:hint="Nhập tên sách"
                android:text ="Test1"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">
                    <TextView style="@style/LabelStyle" android:text="Tên tác giả" />
                    <EditText
                        android:id="@+id/etAuthorName"
                        style="@style/InputStyle"
                        android:hint="Nhập tên tác giả"
                        android:text ="Test1"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">
                    <TextView style="@style/LabelStyle" android:text="Mã sách" />
                    <EditText
                        android:id="@+id/etBookId"
                        style="@style/InputStyle"
                        android:hint="Nhập mã sách"
                        android:text ="Test1"/>
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/LabelStyle" android:text="Thể loại" />
            <EditText
                android:id="@+id/etCategory"
                style="@style/InputStyle"
                android:hint="Nhập thể loại"
                android:text ="Test1"/>

            <TextView style="@style/LabelStyle" android:text="Số lượng" />
            <EditText
                android:id="@+id/etQuantity"
                style="@style/InputStyle"
                android:hint="Nhập số lượng"
                android:inputType="number"
                android:text ="1"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">
                    <TextView style="@style/LabelStyle" android:text="Nhà xuất bản" />
                    <EditText
                        android:id="@+id/etPublisher"
                        style="@style/InputStyle"
                        android:hint="Nhập nhà xuất bản"
                        android:text ="NXB-BK"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">
                    <TextView style="@style/LabelStyle" android:text="Năm xuất bản" />
                    <EditText
                        android:id="@+id/etPublishYear"
                        style="@style/InputStyle"
                        android:hint="Nhập năm xuất bản"
                        android:inputType="number"
                        android:text ="2026"/>
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnSaveBook"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="20dp"
                android:backgroundTint="#0000FF"
                android:text="LƯU VÀO HỆ THỐNG"
                android:textColor="#FFF"
                android:textStyle="bold"
                app:cornerRadius="15dp" />

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavAdmin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        app:menu="@menu/bottom_nav_admin_menu"/>

</RelativeLayout>