<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="THÔNG TIN CÁ NHÂN"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp"
            android:textColor="#000"/>

        <TextView android:text="Mã độc giả" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp"/>
        <EditText android:id="@+id/edtMaDocGia" android:layout_width="match_parent" android:layout_height="50dp"
            android:background="@drawable/bg_input_field" android:enabled="false" android:paddingStart="12dp" android:paddingEnd="12dp"
            android:layout_marginBottom="12dp" android:alpha="0.7" android:hint="Mã số sinh viên" android:importantForAccessibility="no" />

        <TextView android:text="Họ và tên" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp"/>
        <EditText android:id="@+id/edtHoTen" android:layout_width="match_parent" android:layout_height="50dp"
            android:background="@drawable/bg_input_field" android:enabled="false" android:paddingStart="12dp" android:paddingEnd="12dp"
            android:layout_marginBottom="12dp" android:alpha="0.7" android:hint="Họ tên đầy đủ" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2" android:baselineAligned="false">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="6dp">
                <TextView android:text="Giới tính" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp"/>
                <EditText android:id="@+id/edtGioiTinh" android:layout_width="match_parent" android:layout_height="50dp"
                    android:background="@drawable/bg_input_field" android:enabled="false" android:paddingStart="12dp" android:alpha="0.7" android:hint="Nam/Nữ"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="6dp">
                <TextView android:text="Ngày sinh" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp"/>
                <EditText android:id="@+id/edtNgaySinh" android:layout_width="match_parent" android:layout_height="50dp"
                    android:background="@drawable/bg_input_field" android:enabled="false" android:paddingStart="12dp" android:alpha="0.7" android:hint="dd/mm/yyyy"/>
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DDD" android:layout_marginVertical="20dp"/>

        <TextView android:text="Email liên hệ" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#3F51B5"/>
        <EditText android:id="@+id/edtEmail" android:layout_width="match_parent" android:layout_height="50dp"
            android:background="@drawable/bg_input_field" android:paddingStart="12dp" android:paddingEnd="12dp"
            android:layout_marginBottom="12dp" android:inputType="textEmailAddress" android:hint="Nhập email mới" />

        <TextView android:text="Số điện thoại" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#3F51B5"/>
        <EditText android:id="@+id/edtDienThoai" android:layout_width="match_parent" android:layout_height="50dp"
            android:background="@drawable/bg_input_field" android:paddingStart="12dp" android:paddingEnd="12dp"
            android:layout_marginBottom="12dp" android:inputType="phone" android:hint="Số điện thoại cá nhân" />

        <TextView android:text="Địa chỉ thường trú" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#3F51B5"/>
        <EditText android:id="@+id/edtDiaChi1" android:layout_width="match_parent" android:layout_height="50dp"
            android:background="@drawable/bg_input_field" android:paddingStart="12dp" android:paddingEnd="12dp"
            android:layout_marginBottom="12dp" android:hint="Xã, Huyện, Tỉnh..." />

        <TextView android:text="Địa chỉ tạm trú" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#3F51B5"/>
        <EditText android:id="@+id/edtDiaChi2" android:layout_width="match_parent" android:layout_height="50dp"
            android:background="@drawable/bg_input_field" android:paddingStart="12dp" android:paddingEnd="12dp"
            android:layout_marginBottom="24dp" android:hint="Số nhà, ngõ, phố..." />

        <TextView android:text="Cập nhật lần cuối" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#888"/>
        <EditText android:id="@+id/edtNgayCapNhat" android:layout_width="match_parent" android:layout_height="48dp"
            android:background="#EEEEEE" android:enabled="false" android:paddingStart="12dp" android:textSize="12sp"
            android:layout_marginBottom="24dp" android:hint="Thời gian hệ thống" android:minHeight="48dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/bg_blue_card"
            android:text="LƯU THAY ĐỔI"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

    </LinearLayout>
</ScrollView>