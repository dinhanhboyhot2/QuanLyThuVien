<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="80dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">
            <ImageButton
                android:id="@+id/btnBackDetail"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="#FFFFFF"
                android:src="@drawable/ic_back_arrow"
                android:tint="@color/black"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btnLockCard"
                    android:layout_width="wrap_content"
                    android:layout_height="35dp"
                    android:text="KHÓA THẺ"
                    android:textSize="10sp"
                    android:backgroundTint="#FFEBEE"
                    android:textColor="#FF0000" />
                <Button
                    android:id="@+id/btnSaveInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="35dp"
                    android:layout_marginStart="8dp"
                    android:text="LƯU"
                    android:textSize="10sp"
                    android:backgroundTint="#0000FF"
                    android:textColor="#FFF" />
            </LinearLayout>
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvAvatarPlaceholder"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_blue_rounded"
                android:gravity="center"
                android:text="NA"
                android:textColor="#FFF"
                android:textSize="28sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvDetailName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="NGUYỄN VĂN A"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvDetailMssv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MSSV: 231213"
                android:textColor="#888" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:paddingHorizontal="16dp"
            android:weightSum="3">

            <LinearLayout
                android:id="@+id/layoutStatBorrowed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_stat_blue"
                android:gravity="center"
                android:padding="12dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MƯỢN"
                    android:textSize="12sp"
                    android:textColor="#0000FF"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tvCountBorrowed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12"
                    android:textSize="16sp"
                    android:textColor="#0000FF"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutStatHolding"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_stat_orange"
                android:gravity="center"
                android:padding="12dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ĐANG GIỮ"
                    android:textSize="12sp"
                    android:textColor="#FF9800"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tvCountHolding"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textSize="16sp"
                    android:textColor="#FF9800"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutStatViolation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_stat_red"
                android:gravity="center"
                android:padding="12dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VI PHẠM"
                    android:textSize="12sp"
                    android:textColor="#FF0000"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tvCountViolation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="16sp"
                    android:textColor="#FF0000"
                    android:textStyle="bold"/>
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KHOA/NGÀNH"
                android:textStyle="bold"
                android:textSize="12sp"/>
            <EditText
                android:id="@+id/edtMajor"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:background="@drawable/bg_input_border"
                android:text="Công nghệ thông tin"
                android:paddingStart="12dp"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            android:text="SÁCH ĐANG MƯỢN"
            android:textStyle="bold" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cvCurrentBook"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="12dp">
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>